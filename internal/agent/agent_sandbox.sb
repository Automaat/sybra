(version 1)
;; Sybra agent OS-level process sandbox (darwin, sandbox-exec).
;;
;; Reads and everything else stay unrestricted: only file-write* operations
;; are denied by default and re-allowed for the four roots supplied via -D
;; at spawn time (see procsandbox_darwin.go). This is enforce-mode only —
;; report mode validates and logs the same roots without ever passing this
;; profile to sandbox-exec, so a bug here cannot regress a default-posture
;; agent run (see rollback note in internal/config/config_defaults.go's
;; DefaultSandboxMode).
(allow default)
(deny file-write*)
(allow file-write*
  (subpath (param "WORKTREE"))
  (subpath (param "SANDBOX_HOME"))
  (subpath (param "TMP"))
  (subpath (param "SHARED_CACHE"))
  (subpath (param "CLAUDE_STATE"))
  (subpath (param "CODEX_STATE"))
  (subpath (param "COPILOT_STATE"))
  (subpath (param "OPENCODE_STATE"))
  (subpath (param "TOOL_CACHE")))
;; READONLY_DIR re-denies writes for a run whose Dir must stay read-only
;; (RunConfig.ReadOnlyDir) even though it sits inside one of the allowed
;; roots above (TMP in particular is the whole system temp dir, so a
;; manual-test rig that stages every path under one temp sandbox would
;; otherwise make Dir writable through that allow rule). Seatbelt resolves
;; the most specific applicable subpath rule for a given path, so this deny
;; wins over the broader TMP/SANDBOX_HOME allow regardless of declaration
;; order. Set to a fixed, never-written-to sentinel when unused so it never
;; shadows a legitimate writable root.
(deny file-write* (subpath (param "READONLY_DIR")))
