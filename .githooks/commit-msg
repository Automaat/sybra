#!/usr/bin/env bash
set -euo pipefail

# Enforce Conventional Commits (CLAUDE.md rule): "type(scope): description".
# Allowed types match the CI commit linter and the project policy.

msg_file=$1
first_line=$(grep -v '^#' "$msg_file" | head -n1)

# Allow merge / revert auto-messages and fixup/squash.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if ! [[ "$first_line" =~ ^($types)\([a-z0-9._/-]+\):[[:space:]].+ ]]; then
  cat >&2 <<EOF
ERROR: commit subject must follow Conventional Commits.

  Format:  type(scope): description
  Types:   $types
  Scope:   required, lowercase letters/digits/._/-

  Got:     $first_line
EOF
  exit 1
fi

# Enforce 50-char subject limit (CLAUDE.md rule).
if [ "${#first_line}" -gt 50 ]; then
  echo "ERROR: commit subject is ${#first_line} chars (max 50)." >&2
  echo "  Got: $first_line" >&2
  exit 1
fi

# Reject AI attribution lines.
if grep -qiE '(co-authored-by:.*claude|generated by claude)' "$msg_file"; then
  echo "ERROR: do not add AI attribution to commit messages." >&2
  exit 1
fi
