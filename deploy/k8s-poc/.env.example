# Copy this file to deploy/k8s-poc/.env and fill in real values.
# deploy/k8s-poc/.env is git-ignored.

# OpenRouter key used by opencode for openrouter/deepseek/deepseek-v4-flash.
OPENROUTER_API_KEY=replace-me

# GitHub token with clone/push access to the repo used for the e2e task branch.
# Fine-grained token: grant Contents read/write for the target repo.
GITHUB_TOKEN=replace-me
