#!/usr/bin/env bash
# Hermetic stand-in for npm in deploy/tests: no real registry access, no
# real frontend — just enough to satisfy sybra-build.sh's `npm ci` + `npm run
# build:web` and to fail on demand via FAKE_NPM_FAIL for the build-failure
# scenario.
set -euo pipefail
if [[ "${FAKE_NPM_FAIL:-}" == "1" ]]; then
  echo "fake npm: simulated build:web failure" >&2
  exit 1
fi
case "${1:-}" in
  ci) exit 0 ;;
  run)
    if [[ "${2:-}" == "build:web" ]]; then
      mkdir -p dist-web
      echo '<html><body>fake</body></html>' >dist-web/index.html
    fi
    exit 0
    ;;
  *) exit 0 ;;
esac
