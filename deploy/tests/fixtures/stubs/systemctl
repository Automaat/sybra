#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  is-enabled)
    [[ "${FAKE_AGENTD_ENABLED:-0}" == "1" ]]
    ;;
  reset-failed)
    printf '%s\n' "$*" >>"${FAKE_SYSTEMCTL_LOG:?}"
    [[ "${FAKE_AGENTD_RESET_FAIL:-0}" != "1" ]]
    ;;
  --no-block)
    printf '%s\n' "$*" >>"${FAKE_SYSTEMCTL_LOG:?}"
    [[ "${FAKE_AGENTD_RESTART_FAIL:-0}" != "1" ]]
    ;;
  *)
    exit 1
    ;;
esac
