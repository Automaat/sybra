#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  is-enabled)
    [[ "${FAKE_AGENTD_ENABLED:-0}" == "1" ]]
    ;;
  is-failed)
    [[ "${FAKE_AGENTD_FAILED:-0}" == "1" ]]
    ;;
  show)
    printf '%s\n' "${FAKE_AGENTD_LOAD_STATE:-loaded}"
    ;;
  --no-block|reset-failed)
    printf '%s\n' "$*" >>"${FAKE_SYSTEMCTL_LOG:?}"
    ;;
  *)
    exit 1
    ;;
esac
