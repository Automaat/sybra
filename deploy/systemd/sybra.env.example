SYBRA_PORT=8080
# Bare host:port, or a full http(s):// origin for a board that terminates TLS
# (the healthcheck keeps the scheme it is given). Add SYBRA_SERVER_CA=<pem>
# when that board serves its own certificate — the healthcheck pins it the way
# sybra's own client does, so a gen-cert leaf naming another host still works.
SYBRA_SERVER_TARGET=127.0.0.1:8080
SYBRA_SRC_DIR=/opt/sybra/src
# Deploy layout (sybra-build.sh / sybra-healthcheck.sh / sybra-run.sh):
# releases/<id> holds each versioned candidate build; current/last-good are
# symlinks into it, repointed atomically. Leave SYBRA_STATIC_DIR unset — it
# defaults to $SYBRA_CURRENT_LINK/web, tracking whichever release is active.
SYBRA_RELEASES_DIR=/opt/sybra/releases
SYBRA_CURRENT_LINK=/opt/sybra/current
SYBRA_LAST_GOOD_LINK=/opt/sybra/last-good
SYBRA_QUARANTINE_DIR=/opt/sybra/quarantine
SYBRA_DEPLOY_STATE_DIR=/opt/sybra/deploy-state
SYBRA_DEPLOY_LOCK=/opt/sybra/deploy.lock
SYBRA_DISABLE_CODEX_SANDBOX=1
HOME=/home/sybra
PATH=/home/sybra/.local/share/mise/shims:/home/sybra/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
