[Unit]
Description=Sybra agent orchestrator (HTTP server)
Documentation=https://github.com/Automaat/sybra
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=sybra
Group=sybra
WorkingDirectory=/opt/sybra/src
EnvironmentFile=/etc/sybra/sybra.env

ExecStartPre=/opt/sybra/bin/sybra-build.sh
TimeoutStartSec=900

ExecStart=/opt/sybra/bin/sybra-run.sh

KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=45

Restart=on-failure
RestartForceExitStatus=42
SuccessExitStatus=42
RestartSec=3

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
