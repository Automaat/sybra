[Unit]
Description=Sybra thin agent execution daemon
Documentation=https://github.com/Automaat/sybra/blob/main/docs/agentd.md
After=network-online.target sybra.service
Wants=network-online.target
PartOf=sybra.service

StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=exec
User=sybra
Group=sybra
WorkingDirectory=/opt/sybra/src
# Reuse the service account's HOME/PATH/toolchain environment, then layer the
# daemon-only leader token and provider secrets on top.
EnvironmentFile=/etc/sybra/sybra.env
EnvironmentFile=/etc/sybra/sybra-agentd.env
ExecStart=/opt/sybra/current/sybra-agentd -config /etc/sybra/sybra-agentd.yaml

# Stop only the daemon. Provider subprocesses are detached and recorded below
# state_root, so the replacement daemon can re-adopt them after an upgrade.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=45

Restart=on-failure
RestartSec=3

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
