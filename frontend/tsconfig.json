{
  "compilerOptions": {
    "target": "ES2025",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "$lib/*": ["./src/lib/*"]
    },
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "strict": true,
    "libReplacement": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
