{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "VITE_MODE=desktop vite build",
    "build:web": "VITE_MODE=web vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "oxlint .",
    "lint:pins": "node scripts/check-pin-strategy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@skeletonlabs/skeleton": "4.15.2",
    "@skeletonlabs/skeleton-svelte": "4.15.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/dompurify": "3.2.0",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "oxlint": "1.72.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@lucide/svelte": "^1.8.0",
    "@wailsio/runtime": "3.0.0-alpha.95",
    "@xyflow/svelte": "^1.5.2",
    "dompurify": "^3.4.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "marked": "^18.0.0",
    "marked-highlight": "^2.2.4",
    "snarkdown": "^2.0.0"
  }
}
